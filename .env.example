APP_NAME="Laundry LMS"
APP_ENV=local
APP_URL=http://localhost/laundry-lms

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundry_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Online Payment Gateway Configuration
# Supported drivers: 'mock' (local testing/sandbox) or 'razorpay'
PAYMENT_GATEWAY_DRIVER=mock
PAYMENT_GATEWAY_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Webhook subscriptions required for Razorpay dashboard:
# - payment.captured
# - order.paid
# Webhook URL: {APP_URL}/api/payment/webhook
