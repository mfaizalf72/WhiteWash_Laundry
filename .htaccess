<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prevent infinite loops if already in public directory
    RewriteCond %{REQUEST_URI} ^.*/public/ [NC]
    RewriteRule ^ - [L]

    # Rewrite /laundry-lms prefix if present
    RewriteRule ^laundry-lms/(.*)$ public/$1 [L,QSA]

    # Otherwise route directly to public
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
