<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prevent loop if already accessing public
    RewriteCond %{REQUEST_URI} public/ [NC]
    RewriteRule ^ - [L]

    # Handle /laundry-lms/ prefix if present
    RewriteRule ^laundry-lms/(.*)$ public/$1 [L,QSA]

    # Forward all other requests to public
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
